# Cloudflare 用のHTTPヘッダー設定

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# サロン予約デモは「並べて見る」ページ（/demo/salon/both.html）の中に埋め込むため、同じサイトからの埋め込みだけ許可する
/demo/salon/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# 内容を書き換えたとき、閲覧者に確実に届くようにする
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/school/
  Cache-Control: no-cache
/school/index.html
  Cache-Control: no-cache
/demo/*
  Cache-Control: no-cache
/homepage/*
  Cache-Control: no-cache
/line-yoyaku/*
  Cache-Control: no-cache
/pos/*
  Cache-Control: no-cache
/faq/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=300
/shukketsu/
  Cache-Control: no-cache
/shukketsu/index.html
  Cache-Control: no-cache
/terms/
  Cache-Control: no-cache
/privacy/
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
